{% extends "base.html.jinja" %}

{% block tab_opera %}tab-active{% endblock %}

{% block content %}
<div class="bg-olive-50 flex w-full">
  <div class="max-h-screen max-w-1/3 min-w-1/3 overflow-y-scroll px-8 pt-4">
    <form>
      <select class="select" name="selnav" id="selnav">
        {% for key, info in sort_orders.items() %}
        <option value="{{ key }}"{{ ' selected' if key == default_sort else '' }}>{{ info.label }}</option>
        {% endfor %}
      </select>
    </form>

    <script id="sorted-data" type="application/json">{{ sorted_lists_light | tojson }}</script>
    <ul id="list-titles" class="list title-list"></ul>
  </div>

  <div id="biblio" class="max-h-screen max-w-1/2 mt-4 overflow-y-scroll px-8">
    {% for bib_item in items %}
      <div class="card mb-4 p-4 shadow-sm">
        {% with item = bib_item %}
          {% include "components/BibliographicItem.html.jinja" %}
        {% endwith %}
      </div>
    {% endfor %}
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ url_for('static', filename='js/sort.js') }}"></script>
<style>
  .card { content-visibility: auto; contain-intrinsic-size: 200px; }
  div.card:has(article:target) {
    background-color: var(--color-gray-200, #e5e7eb);
  }
</style>
{% endblock %}
