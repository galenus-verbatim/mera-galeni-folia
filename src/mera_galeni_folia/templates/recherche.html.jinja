{% extends "base.html.jinja" %}

{% block title %}Recherche — Galenus Verbatim{% endblock %}

{% block tab_recherche %}tab-active{% endblock %}

{% block content %}
<div class="p-8" x-data="search">
  <h1 class="font-bold text-xl">Sélection des Titres</h1>

  <div class="flex">
    <div class="bg-olive-200 p-8 rounded-sm shadow-md w-full">
      <fieldset class="fieldset flex">
        <input type="radio" class="radio bg-olive-100" id="toutes" name="author" x-model="selectedAuthor" value="Toutes" checked="true" />
        <label class="label mr-4" for="gal">Tout le corpus</label>

        <input type="radio" class="radio bg-olive-100" id="gal" name="author" x-model="selectedAuthor" value="Galenus" />
        <label class="label mr-4" for="gal">Gal.</label>

        <input type="radio" class="radio bg-olive-100" id="ps-gal" name="author" x-model="selectedAuthor" value="Pseudo-Galen" />
        <label class="label mr-4" for="ps-gal">Ps.-Gal.</label>
      </fieldset>

      <fieldset class="fieldset">
        <span>Sujets : </span>
        <div class="flex">
          <template x-for="tag in allTags">
            <div class="control-group">
              <input type="checkbox" class="gommette checkbox bg-olive-100" :id="`_${tag}`" :value="`_${tag}`" x-model="selectedTags" />
              <label class="label mr-4" :for="`_${tag}`" x-text="`${tag}.`"></label>
            </div>
          </template>
        </div>
      </fieldset>

      <fieldset class="fieldset">
        <button
          class="bg-olive-50 hover:bg-olive-100 btn btn-outline my-4"
          type="button"
          @click="clearSelectedTags"
          :disabled="selectedTags.length === 0">Tout décocher
        </button>
        <label class="label">
          <input type="checkbox" class="checkbox bg-olive-100" x-model="ignoreDuplicates" />
          <span class="text-md">Ignorer doublons</span>
        </label>
      </fieldset>
    </div>
  </div>

  <div class="w-full mt-4">
    <fieldset class="fieldset flex items-end gap-4">
      <label class="input flex-grow">
        <span class="label">Recherche par lemme ou forme</span>
        <input
          id="search-input"
          name="search"
          placeholder="E.g., μεταφορά ou *φορ*"
          type="search"
          autocomplete="off"
          spellcheck="false"
          :disabled="!indexLoaded"
          x-model="searchQuery"
          @input.debounce.300ms="runSearch()"
        />
      </label>
      <label class="label">
        <input type="checkbox" class="toggle" x-model="searchByForm" @change="runSearch()" />
        Rechercher par forme ?
      </label>
      <button
        x-show="!indexLoaded"
        :disabled="indexLoading"
        @click="loadSearchIndex()"
        class="bg-olive-50 hover:bg-olive-100 btn btn-outline btn-sm"
        type="button"
        x-text="indexLoading ? 'Chargement…' : 'Charger l\'index'"
      ></button>
    </fieldset>
  </div>

  <div class="overflow-auto max-h-1/2-screen mt-4">
    <span class="prose text-sm text-gray-500">Trier par : </span>
    <table class="table w-full">
      <thead>
        <tr>
          <th :aria-sort="`${sortBy === 'page_kuehn' ? (sortAscending ? 'ascending' : 'descending') : 'none'}`">
            <button class="cursor-pointer" @click="updateSort('page_kuehn')">Page Kühn</button><span aria-hidden="true"></span>
          </th>
          <th :aria-sort="`${sortBy === 'editors' ? (sortAscending ? 'ascending' : 'descending') : 'none'}`">
            <button class="cursor-pointer" @click="updateSort('editors')">Editeur(s)</button><span aria-hidden="true"></span>
          </th>
          <th :aria-sort="`${sortBy === 'greek_title' ? (sortAscending ? 'ascending' : 'descending') : 'none'}`">
            <button class="cursor-pointer" @click="updateSort('greek_title')">Titre grec</button><span aria-hidden="true"></span>
          </th>
          <th :aria-sort="`${sortBy === 'latin_title' ? (sortAscending ? 'ascending' : 'descending') : 'none'}`">
            <button class="cursor-pointer" @click="updateSort('latin_title')">Titre latin</button><span aria-hidden="true"></span>
          </th>
          <th :aria-sort="`${sortBy === 'french_title' ? (sortAscending ? 'ascending' : 'descending') : 'none'}`">
            <button class="cursor-pointer" @click="updateSort('french_title')">Titre français</button><span aria-hidden="true"></span>
          </th>
          <th :aria-sort="`${sortBy === 'english_title' ? (sortAscending ? 'ascending' : 'descending') : 'none'}`">
            <button class="cursor-pointer" @click="updateSort('english_title')">Titre anglais</button><span aria-hidden="true"></span>
          </th>
          <th :aria-sort="`${sortBy === 'tags' ? (sortAscending ? 'ascending' : 'descending') : 'none'}`">
            <button class="cursor-pointer" @click="updateSort('tags')">Sujets</button><span aria-hidden="true"></span>
          </th>
          <th aria-sort="none">
            <span>Détails</span>
          </th>
        </tr>
      </thead>

      <template x-for="edition in editions" :key="edition.cts">
        <tbody>
          <tr
            :class="{
              'cursor-pointer': editionIsClickable(edition),
              'cursor-default': !editionIsClickable(edition),
              'bg-olive-300 hover:bg-olive-400': editionHasResults(edition),
              'hover:bg-olive-200': editionIsClickable(edition) && !editionHasResults(edition),
            }"
            :aria-expanded="openSlideouts[edition.cts] ? 'true' : 'false'"
            @click="editionIsClickable(edition) && (openSlideouts[edition.cts] = !openSlideouts[edition.cts])"
          >
            <td>
              <span class="font-bold" x-text="`${edition.kuehnEditionVolume}.${(edition.kuehnEditionPages || '').split('-')[0]} [${edition.callNumber} Ficht.]`">
            </td>
            <td>
              <span x-show="editionIsClickable(edition)" x-text="openSlideouts[edition.cts] ? '▼' : '▶'" class="text-xs"></span>
              <span x-text="editorLastName(edition.editors)"></span>
            </td>
            <td>
              <a :href="`${baseURL}${edition.cts}`" :title="edition.cts" class="text-yellow-700" x-text="edition.greek_title" @click.stop></a>
            </td>
            <td x-text="edition.latin_title || edition.title"></td>
            <td x-text="edition.french_title"></td>
            <td x-text="edition.english_title"></td>
            <td x-text="edition.tags?.join(', ').replaceAll('_', '')"></td>
            <td>
              <a :href="`${baseURL}#${edition.cts.split('.').slice(0, -1).join('.')}`" title="more info" class="text-yellow-700" target="_blank" @click.stop>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>
            </td>
          </tr>
          <tr x-show="openSlideouts[edition.cts]" x-collapse>
            <td colspan="8" class="bg-olive-50 px-8 py-2">
              <ul class="text-sm space-y-1">
                <template x-for="result in searchResults.filter(r => r.chapter_urn.startsWith(edition.cts + ':'))" :key="result.chapter_urn">
                  <li>
                    <a :href="result.url" class="text-yellow-700" x-text="result.token_urn"></a>
                    <span class="text-gray-500 ml-2" x-text="result.language === 'grc' ? 'grec' : 'latin'"></span>
                  </li>
                </template>
              </ul>
            </td>
          </tr>
        </tbody>
      </template>

    </table>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/sql.js@1.10.3/dist/sql-wasm.js"></script>
<script defer src="{{ url_for('static', filename='vendor/js/alpinejs.collapse.js') }}"></script>
<script defer src="{{ url_for('static', filename='vendor/js/alpinejs.js') }}"></script>
<script>
  const BASE_URL = document.getElementById("base-url").dataset['base-url']

  document.addEventListener('alpine:init', () => {
    Alpine.data('search', () => ({
      // --- edition browsing state ---
      allTags: {{all_tags|tojson}},
      allEditions: {{editions|tojson}},
      baseURL: BASE_URL,
      ignoreDuplicates: false,
      sortAscending: true,
      sortBy: 'page_kuehn',
      selectedAuthor: 'Toutes',
      selectedTags: [],
      selectedWorks: [],
      openSlideouts: {},

      // --- full-text search state ---
      db: null,
      indexLoading: false,
      indexLoaded: false,
      searchByForm: false,
      searchQuery: '',
      searchResults: [],

      // --- edition browsing methods ---
      clearSelectedTags() { this.selectedTags = []; },
      get editions() { return this.filterEditions(); },
      editorLastName(editor) { return editor.split(', ')[0]; },

      filterEditions() {
        let editionsFiltered = this.allEditions;

        if (this.selectedAuthor !== 'Toutes') {
          editionsFiltered = editionsFiltered.filter(e => e.authors === this.selectedAuthor);
        }
        if (this.selectedTags.length > 0) {
          editionsFiltered = editionsFiltered.filter(e =>
            this.selectedTags.every(t => e.tags.includes(t))
          );
        }
        return this.sortEditions(editionsFiltered);
      },

      sortEditions(editionsFiltered) {
        let editionsSorted = editionsFiltered;

        if (this.sortBy === "page_kuehn") {
          editionsSorted = editionsFiltered.toSorted((a, b) => {
            const aFichtner = parseInt((a.callNumber || '0').replace(/[^\d]/, ""));
            const bFichtner = parseInt((b.callNumber || '0').replace(/[^\d]/, ""));

            return this.sortAscending
              ? aFichtner - bFichtner
              : bFichtner - aFichtner;
          })
        } else if (this.sortBy === 'editors') {
          editionsSorted = editionsFiltered.toSorted((a, b) => {
            const aEditor = this.editorLastName(a.editors);
            const bEditor = this.editorLastName(b.editors);
            return this.sortAscending
              ? -aEditor.localeCompare(bEditor)
              : aEditor.localeCompare(bEditor);
          });
        } else if (this.sortBy === 'tags') {
          editionsSorted = editionsFiltered.toSorted((a, b) => {
            const aTagsCleaned = a.tags.map(t => t.replace('_', ''));
            const bTagsCleaned = b.tags.map(t => t.replace('_', ''));
            const minTagIndexA = Math.min(...aTagsCleaned.map(t => this.allTags.indexOf(t)));
            const minTagIndexB = Math.min(...bTagsCleaned.map(t => this.allTags.indexOf(t)));
            return this.sortAscending
              ? minTagIndexA - minTagIndexB
              : minTagIndexB - minTagIndexA;
          });
        } else {
          editionsSorted = editionsFiltered.toSorted((a, b) => {
            const aField = a[this.sortBy] || a['title'] || '';
            const bField = b[this.sortBy] || b['title'] || '';
            return this.sortAscending
              ? -aField.localeCompare(bField)
              : aField.localeCompare(bField);
          });
        }

        if (this.ignoreDuplicates) {
          let seenURNs = {};
          editionsSorted = editionsSorted.filter(e => {
            const ctsURN = e.cts.split(':')[3];
            const withoutVersion = ctsURN.split('.').slice(0, 2).join('.');
            if (seenURNs[withoutVersion]) return false;
            seenURNs[withoutVersion] = true;
            return true;
          });
        }

        return editionsSorted;
      },

      updateSort(sortColumn) {
        if (this.sortBy === sortColumn) {
          this.sortAscending = !this.sortAscending;
          return;
        }
        this.sortBy = sortColumn;
        this.sortAscending = false;
      },

      // --- full-text search methods ---
      editionHasResults(edition) {
        return this.searchResults.some(r => r.chapter_urn.startsWith(edition.cts + ':'));
      },

      editionIsClickable(edition) {
        return this.editionHasResults(edition);
      },

      async init() {
        try {
          const buf = await this._loadFromCache();
          if (!buf) return;
          const SQL = await initSqlJs({
            locateFile: (f) => `https://cdn.jsdelivr.net/npm/sql.js@1.10.3/dist/${f}`,
          });
          this.db = new SQL.Database(new Uint8Array(buf));
          this.indexLoaded = true;
        } catch (e) {
          // Cache miss or IDB error — fall through to show the load button.
        }
      },

      async loadSearchIndex() {
        this.indexLoading = true;
        try {
          const SQL = await initSqlJs({
            locateFile: (f) => `https://cdn.jsdelivr.net/npm/sql.js@1.10.3/dist/${f}`,
          });
          const res = await fetch("{{ url_for('static', filename='search-index.sqlite') }}");
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const buf = await res.arrayBuffer();
          this.db = new SQL.Database(new Uint8Array(buf));
          this.indexLoaded = true;
          this._saveToCache(buf).catch(() => {});
        } catch (err) {
          alert(`Erreur de chargement de l'index : ${err.message}`);
        } finally {
          this.indexLoading = false;
        }
      },

      runSearch() {
        if (!this.db) return;
        if (this.searchQuery === "*") return;

        const useLike = this._useLikeSearch(this.searchQuery);
        if (useLike) {
          this._runLikeSearch();
        } else {
          this._runFtsSearch();
        }
      },

      _buildFtsQuery(raw) {
        const normalized = this._stripDiacritics(raw.trim());
        if (!normalized) return null;
        // Preserve * so FTS4 can treat trailing * as a prefix wildcard.
        const sanitized = normalized.replace(/["()^]/g, '').trim();
        if (!sanitized) return null;
        const words = sanitized.split(/\s+/).filter(Boolean);
        if (words.length === 0) return null;
        // For multi-word queries strip * (FTS4 doesn't support prefix inside phrases).
        const cleanWords = words.length === 1
          ? words
          : words.map(w => w.replace(/\*/g, ''));
        const phrase = cleanWords.length === 1 ? cleanWords[0] : `"${cleanWords.join(' ')}"`;
        const column = this.searchByForm ? 'form' : 'lemma';
        return `${column}:${phrase}`;
      },

      _buildLikePattern(raw) {
        const normalized = this._stripDiacritics(raw.trim());
        if (!normalized) return null;
        const pattern = normalized.replace(/["()^]/g, '').replace(/\*/g, '%').trim();
        return pattern || null;
      },

      _buildWorkFilter(params) {
        if (this.selectedWorks.length === 0) return '';
        const placeholders = this.selectedWorks.map(() => 't.token_urn LIKE ?').join(' OR ');
        this.selectedWorks.forEach(cts => params.push(cts + ':%'));
        return `AND (${placeholders})`;
      },

      _collectRows(stmt) {
        const rows = [];
        while (stmt.step()) rows.push(stmt.getAsObject());
        stmt.free();
        return rows.map(row => ({
          ...row,
          url: `${BASE_URL}${row.chapter_urn}#${row.token_urn}`
        }));
      },

      _openIdb() {
        return new Promise((resolve, reject) => {
          const req = indexedDB.open('galenus-search', 1);
          req.onupgradeneeded = (e) => e.target.result.createObjectStore('index');
          req.onsuccess = () => resolve(req.result);
          req.onerror = () => reject(req.error);
        });
      },

      async _loadFromCache() {
        const idb = await this._openIdb();
        return new Promise((resolve, reject) => {
          const req = idb.transaction('index', 'readonly').objectStore('index').get('search-index');
          req.onsuccess = () => resolve(req.result ?? null);
          req.onerror = () => reject(req.error);
        });
      },

      _runFtsSearch() {
        const ftsQuery = this._buildFtsQuery(this.searchQuery);
        if (!ftsQuery) { this.searchResults = []; return; }
        try {
          const params = [ftsQuery];
          const workFilter = this._buildWorkFilter(params);
          const stmt = this.db.prepare(`
            SELECT t.token_urn, t.title, t.language,
                   CASE WHEN instr(t.token_urn, '@') > 0
                        THEN substr(t.token_urn, 1, instr(t.token_urn, '@') - 1)
                        ELSE t.token_urn END AS chapter_urn
            FROM tokens t
            JOIN (SELECT rowid FROM search_fts WHERE search_fts MATCH ?) AS fts
              ON t.id = fts.rowid
            ${workFilter}
            GROUP BY chapter_urn
            LIMIT 50
          `);
          stmt.bind(params);
          this.searchResults = this._collectRows(stmt);
        } catch (err) {
          console.error('Search error:', err);
          this.searchResults = [];
        }
      },

      _runLikeSearch() {
        const likePattern = this._buildLikePattern(this.searchQuery);
        if (!likePattern) { this.searchResults = []; return; }
        const column = this.searchByForm ? 'form' : 'lemma';
        try {
          const params = [likePattern];
          const workFilter = this._buildWorkFilter(params);
          const stmt = this.db.prepare(`
            SELECT t.token_urn, t.title, t.language,
                   CASE WHEN instr(t.token_urn, '@') > 0
                        THEN substr(t.token_urn, 1, instr(t.token_urn, '@') - 1)
                        ELSE t.token_urn END AS chapter_urn
            FROM tokens t
            JOIN search_fts fts ON t.id = fts.rowid
            WHERE fts.${column} LIKE ?
            ${workFilter}
            GROUP BY chapter_urn
            LIMIT 50
          `);
          stmt.bind(params);
          this.searchResults = this._collectRows(stmt);
        } catch (err) {
          console.error('Search error:', err);
          this.searchResults = [];
        }
      },

      async _saveToCache(buf) {
        const idb = await this._openIdb();
        return new Promise((resolve, reject) => {
          const tx = idb.transaction('index', 'readwrite');
          tx.objectStore('index').put(buf, 'search-index');
          tx.oncomplete = resolve;
          tx.onerror = () => reject(tx.error);
        });
      },

      _stripDiacritics(str) {
        return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      },

      _useLikeSearch(raw) {
        // Use LIKE when the query has a leading wildcard — FTS4 can't handle those.
        return this._stripDiacritics(raw.trim()).startsWith('*');
      },

    }));
  });
</script>

<style>
  th[aria-sort="ascending"] span::after {
    color: currentColor;
    content: "▼";
    font-size: 100%;
    margin-left: 4px;
    top: 0;
  }

  th[aria-sort="descending"] span::after {
    color: currentColor;
    content: "▲";
    font-size: 100%;
    margin-left: 4px;
    top: 0;
  }
</style>
{% endblock %}
