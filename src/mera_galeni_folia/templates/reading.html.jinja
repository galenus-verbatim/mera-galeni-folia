{% extends "base.html.jinja" %}

{% block title %}{{ edition_title }} — Galenus Verbatim{% endblock %}

{% block body_class %}cts{% endblock %}

{% block content %}
<div class="bg-olive-50 flex pt-4 w-full">
  {# ── Left column: chapter navigation ── #}
  <nav class="max-h-screen max-w-1/4 min-w-1/4 overflow-y-scroll px-8">
    <ul>
      {% for nav_item in toc.get("table_of_contents", []) %}
        {% with item = nav_item %}
          {% include 'components/NavigationItem.html.jinja' %}
        {% endwith %}
      {% endfor %}
    </ul>
  </nav>

  {# ── Center column: Greek / Latin text ── #}
  <div class="max-w-1/2 mx-4">
    <div class="bg-white card mb-4 p-4 shadow-sm">
      {% with item = zotero_item %}
        {% include "components/BibliographicItem.html.jinja" %}
      {% endwith %}
    </div>
    <div class="text">
      {% for container in text_containers %}
        {% with text_container = container %}
          {% include 'components/ReadableTextContainer.html.jinja' %}
        {% endwith %}
      {% endfor %}
    </div>
  </div>

  {# ── Right column: IIIF facsimile viewer ── #}
  {% if image_vars %}
    <div id="pagimage">
      <header id="image_nav">
        <a class="prev" id="image_prev" title="Page précédente">&#9664;</a>
        <span id="image_title"></span>
        <a class="next" id="image_next" title="Page suivante">&#9654;</a>
      </header>
      <div id="osd-viewer" style="width:100%; height:600px;"></div>
    </div>
  {% endif %}
</div>
{% endblock %}

{% block scripts %}
{% if image_vars %}
<script>
{{ image_vars | safe }}
</script>
{% endif %}
<script src="https://cdn.jsdelivr.net/npm/openseadragon@5.0/build/openseadragon/openseadragon.min.js"></script>
<script src="{{ url_for('static', filename='js/galenus.js') }}"></script>
{% endblock %}
