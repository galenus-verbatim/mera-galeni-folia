{% extends "base.html.jinja" %}

{% block title %}{{ edition_title }} — Galenus Verbatim{% endblock %}

{% block body_class %}cts{% endblock %}

{% block content %}
<div class="bg-olive-50 flex pt-4 w-full" x-data="{ showViewer: true }">
  {# ── Left column: chapter navigation ── #}
  {% if text_containers[0].subtype != "work" %}
    <ul class="menu [&_li>*]:rounded-none flex-nowrap max-h-screen overflow-y-auto w-1/5 px-4">
      {% for nav_item in toc.get("table_of_contents", []) %}
        {% with item = nav_item %}
          {% include 'components/NavigationItem.html.jinja' %}
        {% endwith %}
      {% endfor %}
    </ul>
  {% endif %}

  {# ── Center column: Greek / Latin text ── #}
  <div class="mx-4 flex-1 min-w-0 transition-all duration-300 ease-in-out resize-x" :class="showViewer ? 'max-w-2/5' : 'max-w-none'">
    <div class="bg-white card mb-4 p-4 shadow-sm overflow-y-scroll max-h-48">
      {% with item = zotero_item %}
        {% include "components/BibliographicItem.html.jinja" %}
      {% endwith %}
    </div>
    <div class="mt-8">
      <span>
        {% if zotero_item.author.name == "Galenus" %}
          Gal.
        {% elif zotero_item.author.name == "Pseudo-Galenus" %}
          Ps. Gal.
        {% endif %}
      </span>
      <em>{{ zotero_item.title }}</em>,
      <span>
        ed. {{ critical_edition.creators | selectattr('creatorType', 'equalto', 'editor') | map(attribute='lastName') | join("and") | default('') }},
      </span>
      <span>{{ critical_edition.date }}</span>,
      {% if critical_edition.volume %}
        <span>vol. {{ critical_edition.volume }}</span>,
      {% endif %}
      <span>{{ page_citation }}</span>.
      <span>{{ current_urn.rsplit(":", 1)[1] }}</span>.
      <span>{{ critical_edition.extra.split('CTS URN: ')[1] if critical_edition.extra and 'CTS URN: ' in critical_edition.extra else '' }}</span>
    </div>
    <div class="join grid grid-cols-2 py-8">
      {% if previous_urn %}
        <a class="join-item btn btn-outline" href="{{ url_for('reading', urn=previous_urn) }}">Previous</a>
      {% endif %}
      {% if next_urn %}
        <a class="join-item btn btn-outline{% if not previous_urn %} col-start-2{% endif %}" href="{{  url_for('reading', urn=next_urn) }}">Next</a>
      {% endif %}
    </div>
    <div class="text">
      {% for container in text_containers %}
        {% with text_container = container %}
          {% include 'components/ReadableTextContainer.html.jinja' %}
        {% endwith %}
      {% endfor %}
    </div>
    <div class="join grid grid-cols-2 py-8">
      {% if previous_urn %}
        <a class="join-item btn btn-outline" href="{{ url_for('reading', urn=previous_urn) }}">Previous</a>
      {% endif %}
      {% if next_urn %}
        <a class="join-item btn btn-outline" href="{{  url_for('reading', urn=next_urn) }}">Next</a>
      {% endif %}
    </div>
  </div>

  {# ── Right column: IIIF facsimile viewer ── #}
  <button
    type="button"
    @click="showViewer = !showViewer"
    class="btn bg-olive-500 text-olive-100 hover:bg-olive-400 self-stretch mt-4 mb-8 shrink-0 w-8 px-0"
    :aria-label="showViewer ? 'Masquer le fac-similé' : 'Afficher le fac-similé'"
    :title="showViewer ? 'Masquer le fac-similé' : 'Afficher le fac-similé'"
  >
    <span x-text="showViewer ? '›' : '‹'"></span>
  </button>
  <div
    class="shrink-0 overflow-hidden transition-all duration-300 ease-in-out"
    :class="showViewer ? 'w-1/3' : 'w-0'"
  >
    <div
      class="w-full h-full transition-transform duration-300 ease-in-out"
      :class="showViewer ? 'translate-x-0' : 'translate-x-full'"
    >
      {% include 'components/IIIFViewer.html.jinja' %}
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
{% if image_vars %}
<script>{{ image_vars | safe }}</script>
{% endif %}
<script src="{{ url_for('static', filename='vendor/js/openseadragon.min.js') }}"></script>
<script defer src="{{ url_for('static', filename='vendor/js/alpinejs.js') }}"></script>
<script type="text/javascript">
  document.addEventListener("DOMContentLoaded", () => {
    let hash = document.location.hash;

    if (hash && hash.length > 0) {
      hash = decodeURIComponent(hash);

      const el = document.getElementById(hash.replace("#", ""));

      if (el) {
        el.classList.add("bg-yellow-400");

        el.scrollIntoView();
      }
    }
  });
</script>
{% endblock %}
