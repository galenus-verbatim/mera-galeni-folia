{% extends "base.html.jinja" %}

{% block title %}{{ edition_title }} — Galenus Verbatim{% endblock %}

{% block body_class %}cts{% endblock %}

{% block content %}
<div class="bg-olive-50 flex pt-4 w-full">
  {# ── Left column: chapter navigation ── #}
  {% if text_containers[0].subtype != "work" %}
    <ul class="menu [&_li>*]:rounded-none flex-nowrap max-h-screen overflow-y-auto max-w-1/4 min-w-1/4 px-4">
      {% for nav_item in toc.get("table_of_contents", []) %}
        {% with item = nav_item %}
          {% include 'components/NavigationItem.html.jinja' %}
        {% endwith %}
      {% endfor %}
    </ul>
  {% endif %}

  {# ── Center column: Greek / Latin text ── #}
  <div class="max-w-1/3 mx-4">
    <div class="bg-white card mb-4 p-4 shadow-sm">
      {% with item = zotero_item %}
        {% include "components/BibliographicItem.html.jinja" %}
      {% endwith %}
    </div>
    <div class="mt-8">
      <em>{{ zotero_item.title }}</em>,
      <span>
        ed. {{ critical_edition.creators | selectattr('creatorType', 'equalto', 'editor') | map(attribute='lastName') | join("and") | default('') }}
      </span>,
      <span>{{ critical_edition.date }}</span>,
      {% if critical_edition.volume %}
      <span>vol. {{ critical_edition.volume }}</span>,
      {% endif %}
      <span>{{ page_citation }}</span>.
      <span>{{ critical_edition.extra.split('CTS URN: ')[1] if critical_edition.extra and 'CTS URN: ' in critical_edition.extra else '' }}</span>
    </div>
    <div class="join grid grid-cols-2 py-8">
      {% if previous_urn %}
        <a class="join-item btn btn-outline" href="{{ url_for('reading', urn=previous_urn) }}">Previous</a>
      {% endif %}
      {% if next_urn %}
        <a class="join-item btn btn-outline" href="{{  url_for('reading', urn=next_urn) }}">Next</a>
      {% endif %}
    </div>
    <div class="text">
      {% for container in text_containers %}
        {% with text_container = container %}
          {% include 'components/ReadableTextContainer.html.jinja' %}
        {% endwith %}
      {% endfor %}
    </div>
    <div class="join grid grid-cols-2 py-8">
      {% if previous_urn %}
        <a class="join-item btn btn-outline" href="{{ url_for('reading', urn=previous_urn) }}">Previous</a>
      {% endif %}
      {% if next_urn %}
        <a class="join-item btn btn-outline" href="{{  url_for('reading', urn=next_urn) }}">Next</a>
      {% endif %}
    </div>
  </div>

  {# ── Right column: IIIF facsimile viewer ── #}
  <div id="pagimage" class="h-full w-1/3">
    <header id="image_nav" class="text-center">
      <a class="prev" id="image_prev" title="Page précédente">&#9664;</a>
      <span id="image_title"></span>
      <a class="next" id="image_next" title="Page suivante">&#9654;</a>
    </header>
    <div class="relative">
      <div id="osd-viewer" style="width:100%; height:600px;"></div>
      <div id="iiif-loading" class="absolute inset-0 flex items-center justify-center pointer-events-none hidden">
        <svg class="iiif-spinner" width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Chargement…" role="img">
          <circle cx="28" cy="28" r="24" stroke="white" stroke-width="4" stroke-opacity="0.3"/>
          <circle cx="28" cy="28" r="24" stroke="white" stroke-width="4" stroke-dasharray="37.7 113.1" stroke-linecap="round"/>
        </svg>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
{% if image_vars %}
<script>{{ image_vars | safe }}</script>
{% endif %}
<script src="{{ url_for('static', filename='vendor/js/openseadragon.min.js') }}"></script>
<script type="text/javascript">
  document.addEventListener("DOMContentLoaded", () => {
    let hash = document.location.hash;

    if (hash && hash.length > 0) {
      hash = decodeURIComponent(hash);

      const el = document.getElementById(hash.replace("#", ""));

      el.classList.add("bg-yellow-400");

      el.scrollIntoView();
    }
  });
</script>
{% endblock %}
